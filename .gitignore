# macOS Finder metadata - never meaningful, sometimes leaks folder names.
.DS_Store

# Downloaded third-party source data. Regenerated by tools/fetch-sources.mjs
# from pinned commits; only the built output under public/data/ is committed.
.cache/

# Diagnostic reports written by the build (source diffs etc.). Reproducible.
reports/

node_modules/

# Temporary git worktree used by scripts/deploy.sh to stage the gh-pages branch.
.publish/

# Scratch copies of generated data (build/test backups) are never committed.
public/data.*/

# Sync-conflict duplicates (e.g. "search 4.json", "days 5/") are never committed.
* [0-9].*
* [0-9]/
